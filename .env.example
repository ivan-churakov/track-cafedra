# Same-origin /api is proxied to Java by Next.js in development and Nginx in production.
NEXT_PUBLIC_API_URL=
BACKEND_INTERNAL_URL=http://127.0.0.1:8080
NEXT_PUBLIC_STUDY_PLAN_ID_1=1
NEXT_PUBLIC_STUDY_PLAN_ID_2=2
# Empty hides the Telegram popup until your bot is configured.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
