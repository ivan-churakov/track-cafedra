# Generate deploy/.env.production with: bash deploy/init-env.sh https://YOUR_DOMAIN
PUBLIC_ORIGIN=
APP_PORT=8090
RELEASE_TAG=local
# Optional independent frontend release; empty uses RELEASE_TAG.
FRONTEND_RELEASE_TAG=
POSTGRES_DB=track_cafedra
POSTGRES_USER=track_app
POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
TELEGRAM_BOT_SECRET=
STUDY_PLAN_ID_1=1
STUDY_PLAN_ID_2=2

# Empty hides the popup. Configure both fields before enabling --profile telegram.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=

# Registration emails require a working SMTP account.
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@edu.mirea.ru
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
REGISTRATION_EMAIL_DOMAINS=edu.mirea.ru,mirea.ru

SCHEDULE_SYNC_ENABLED=true
SCHEDULE_SYNC_CRON='0 0 3 * * *'
SCHEDULE_CACHE_TTL_HOURS=24
POSTGRES_MEMORY=512m
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_MAX_CONNECTIONS=50
BACKEND_MEMORY=768m
FRONTEND_MEMORY=512m
BOT_MEMORY=384m
