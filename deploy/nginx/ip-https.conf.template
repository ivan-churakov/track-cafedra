server {
    listen 80;
    listen [::]:80;
    server_name SERVER_IP;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://SERVER_IP$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name SERVER_IP;
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/track-cafedra-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/track-cafedra-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:track_cafedra_ssl:1m;
    ssl_session_timeout 1d;
    client_max_body_size 12m;

    location = /video.mp4 {
        alias /var/lib/track-cafedra/media/video.mp4;
        default_type video/mp4;
    }

    location = /TVP.MP4 {
        alias /var/lib/track-cafedra/media/TVP.MP4;
        default_type video/mp4;
    }

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }
}
